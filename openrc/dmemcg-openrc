#!/sbin/openrc-run
# SPDX-License-Identifier: MIT
# shellcheck disable=SC2034

description="VRAM protection broker for OpenRC using DMEM low"
command="/usr/sbin/dmemcg-openrcd"
command_args="--cgroup ${dmemcg_cgroup:-/sys/fs/cgroup/openrc.dmem-run} --socket ${dmemcg_socket:-/run/dmemcg-openrc/control.sock}"
supervisor="supervise-daemon"
respawn_delay=2
respawn_max=5
respawn_period=60
output_logger="logger -t '${RC_SVCNAME}'"
error_logger="logger -t '${RC_SVCNAME}' -p daemon.err"

depend() {
	need cgroups
	use logger
	after localmount
}

start_pre() {
	if [ "$(stat -fc %T /sys/fs/cgroup 2>/dev/null)" != "cgroup2fs" ]; then
		eerror "A unified cgroup v2 hierarchy is required"
		return 1
	fi
	if ! grep -qw dmem /sys/fs/cgroup/cgroup.controllers; then
		eerror "The dmem controller is unavailable"
		return 1
	fi
	if ! grep -q . /sys/fs/cgroup/dmem.capacity; then
		eerror "No device-memory region is registered"
		return 1
	fi
}
